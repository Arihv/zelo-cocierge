# Web Push (admin devices)
# Public key is safe to expose to the browser.
VITE_VAPID_PUBLIC_KEY=

# Supabase Edge Function secrets (configure in Supabase, not in this file)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@seu-dominio.com.br

# Chave secreta de assinatura do webhook do Mercado Pago (painel do Mercado
# Pago > Suas integrações > Webhooks > Configurar notificações > Assinatura
# secreta). Sem ela, a função mercado-pago-webhook aceita notificações sem
# validar a assinatura x-signature.
# MERCADO_PAGO_WEBHOOK_SECRET=
